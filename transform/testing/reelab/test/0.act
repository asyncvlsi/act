/*
 * Fixture for compatible process re-elaboration.
 *
 * Every leaf here is a defproc rather than a defcell, which is the point: the
 * edit API documents its requirement as an identical port list, and these
 * exercise that a composite process satisfying it is accepted.
 */
defproc leaf_one (bool in, out)
{
  bool q[1];
  prs {
    in -> q[0]-
    q[0] -> out-
  }
}

defproc leaf_two (bool in, out)
{
  bool q[3];
  prs {
    in -> q[0]-
    q[0] -> q[1]-
    q[1] -> q[2]-
    q[2] -> out-
  }
}

/* Same base types, one extra port: must still be refused. */
defproc leaf_wide (bool in, out, extra)
{
  bool q[1];
  prs {
    in -> q[0]-
    q[0] -> out-
    q[0] -> extra-
  }
}

defproc holder (bool in, out)
{
  leaf_one u (in, out);
}

holder h;
