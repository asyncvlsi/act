defproc gen_inv (bool? i; bool! o)
{
  prs {
    i => o-
  }
}

template<pint X | pint Y>
defproc end_at_inv (bool? i;  bool! o)
{
  bool p;
  gen_inv x(i,p);
  gen_inv x2(p,o);
  gen_inv w[X];
  w[0] = x;
  gen_inv w2[Y];
  w2[0] = x2;
}


defproc foo()
{
   end_at_inv<2,1> x[3];
   end_at_inv<2,2> x[4..4];
   x[0]=x[1];
}

foo t;
